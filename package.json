{
  "name": "ping-alert-v2",
  "version": "0.1.0",
  "private": true,
  "description": "Windows desktop network monitoring application",
  "author": "Ping Alert",
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "icons": "node scripts/generate-icon.mjs",
    "build:win": "npm run typecheck && npm run build && electron-builder --win --config electron-builder.yml"
  },
  "dependencies": {
    "i18next": "^26.4.0",
    "net-snmp": "^3.26.3",
    "nodemailer": "^9.0.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/net-snmp": "^3.23.0",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "png-to-ico": "^3.0.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.12",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  }
}
